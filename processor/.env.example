# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── LLM Backend ────────────────────────────────────────────────────────────────
BACKEND=ollama

# ── Ollama backend (used when BACKEND=ollama) ───────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── OpenAI-compatible backend (used when BACKEND=openai) ───────────────────────
OPENAI_URL=http://localhost:1234
OPENAI_API_KEY=

# ── Model assignments per mode ─────────────────────────────────────────────────
MODEL_THINKING=deepseek-r1:14b
MODEL_CODER=gpt-oss:20b
MODEL_DEFAULT=llama3.2:3b
MODEL_EMBED=nomic-embed-text

# ── Queue ──────────────────────────────────────────────────────────────────────
CONCURRENCY=4
CONCURRENCY_EXPRESS=8
JOB_TIMEOUT_MS=600000

# ── Auth ───────────────────────────────────────────────────────────────────────
API_KEY=

# ── HTTPS ──────────────────────────────────────────────────────────────────────
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt

# ── SQLite job log ─────────────────────────────────────────────────────────────
DB_PATH=./data/jobs.db          # path relative to processor/ folder
LOG_RETENTION_DAYS=30           # jobs older than this are auto-purged

# ── Structured logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info                  # debug | info | warn | error
LOG_FORMAT=pretty               # pretty (coloured, dev) | json (one line, production)
