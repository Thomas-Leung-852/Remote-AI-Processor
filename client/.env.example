# ── AI Processor connection ────────────────────────────────────────────────────
AI_PROCESSOR_URL=https://192.168.1.x:3000   # replace with your PC's IP
AI_PROCESSOR_KEY=                           # match API_KEY on the processor; leave blank if auth disabled

# ── Client identity ────────────────────────────────────────────────────────────
# Identifies this machine in the job log and dashboard.
# Use a short, descriptive name. If blank, a random ID is generated at startup.
CLIENT_ID=AI Processor test client

# ── Timeout ───────────────────────────────────────────────────────────────────
AI_REQUEST_TIMEOUT_MS=900000   # 15 min — prevents disconnect while model is generating

# ── AI generation parameters ──────────────────────────────────────────────────
AI_TEMPERATURE=0.1    # low = deterministic code output; raise for creative text tasks
AI_TOP_P=0.95         # nucleus sampling — controls token selection diversity
AI_SEED=42            # fixed seed for reproducible results (same prompt = same output)
